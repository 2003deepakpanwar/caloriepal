PORT=4000
MONGODB_URI=mongodb://localhost:27017/caloriepal
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# AI provider (OpenAI-compatible: Groq, OpenAI, Together, OpenRouter)
# Signup for a free Groq key: https://console.groq.com
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_VISION_MODEL=qwen/qwen3.8-27b
AI_TEXT_MODEL=openai/gpt-oss-20b
AI_DAILY_LIMIT=20

# Nutrition lookup (optional, Phase 4.5)
USDA_API_KEY=

# Dinner planner cron (Phase 6)
CRON_SECRET=
ENABLE_IN_PROCESS_CRON=true
DINNER_CRON_SCHEDULE=0 18 * * *
DINNER_CRON_TIMEZONE=Asia/Kolkata
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
